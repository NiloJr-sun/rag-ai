# Copy to .env and fill in. .env is gitignored; this file is the tracked
# record of which variables the project needs.
#
# Loaded by backend/app/config.py, which is also where every default lives.
# Resolution order: a real environment variable, then a line in .env, then
# the default in config.py. Values that merely restate a default are left
# commented out here, so an uncommented line always means a deliberate
# override.

# --- Postgres / Supabase (T1.4) ---
# The only value the project actually requires. Settings -> Database ->
# Connection string. Single-quote it, and percent-encode any of @ / : # ? in
# the password. Use the direct (5432) URL for migrations; poolers reject some
# DDL.
DATABASE_URL=

# Separate database for the storage integration tests, which insert and
# delete rows. Deliberately not DATABASE_URL: config.py loads this file, so
# DATABASE_URL is almost always set, and reusing it would point the tests at
# whatever database you actually work against. Unset means those tests skip.
# TEST_DATABASE_URL=postgresql://postgres:test@127.0.0.1:55432/postgres

# --- Ollama (T1.5) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_CHAT_MODEL=qwen2

# --- Retrieval (T1.9, T2.8) ---
# How many chunks are fed to the model. Worth tuning: too few and there is
# nothing to answer from, too many and the prompt fills with noise.
# RETRIEVAL_TOP_K=5

# --- FastAPI (T2.1) ---
# The default host is 127.0.0.1. Set 0.0.0.0 only when you intend to accept
# connections from outside this machine -- there is no authentication yet.
# API_HOST=127.0.0.1
# API_PORT=8000

# --- Not read yet -------------------------------------------------------
# Chunk size and overlap are currently constants in app/rag/chunking.py;
# T2.4 makes them configurable.
# CHUNK_SIZE=500
# CHUNK_OVERLAP=64

# The backend talks to Postgres directly with psycopg, so the PostgREST
# credentials are unused. They would only be needed if a client used
# supabase-py instead.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Later targets ------------------------------------------------------
# NEXT_PUBLIC_API_URL=http://localhost:8000        # T4.1
# GOOGLE_CLIENT_ID=                                # T5.1
# GOOGLE_CLIENT_SECRET=
# GOOGLE_DRIVE_FOLDER_ID=
# REDIS_URL=redis://localhost:6379/0               # T6.2
