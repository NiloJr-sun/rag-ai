# Copy to .env and fill in. .env is gitignored; this file is the tracked
# record of which variables the project needs.

# --- Supabase + pgvector (T1.4) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection, used for pgvector queries
DATABASE_URL=

# --- Ollama (T1.5) ---
# Defaults live in backend/app/rag/embeddings.py; uncomment only to override.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_CHAT_MODEL=qwen2

# --- RAG tuning (T1.3, T1.9, T2.4, T2.8) ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=5

# --- FastAPI (T2.1) ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Next.js (T4.1) ---
# NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Google Drive (T5.1) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# GOOGLE_DRIVE_FOLDER_ID=

# --- Redis (T6.2) ---
# REDIS_URL=redis://localhost:6379/0
